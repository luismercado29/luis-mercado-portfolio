---
import * as si from "simple-icons";
interface Props { name: string; size?: number }
const { name, size = 22 } = Astro.props;
const map: Record<string, any> = {
  Java: si.siOpenjdk, Python: si.siPython, TypeScript: si.siTypescript, JavaScript: si.siJavascript,
  "C++": si.siCplusplus, HTML: si.siHtml5, CSS: si.siCss, "Next.js": si.siNextdotjs, React: si.siReact,
  Angular: si.siAngular, Tailwind: si.siTailwindcss, "Spring Boot": si.siSpringboot, "Spring Cloud": si.siSpring,
  FastAPI: si.siFastapi, Django: si.siDjango, PostgreSQL: si.siPostgresql, MySQL: si.siMysql, Prisma: si.siPrisma,
  PyTorch: si.siPytorch, "scikit-learn": si.siScikitlearn, Git: si.siGit, GitHub: si.siGithub, Vercel: si.siVercel,
  n8n: si.siN8n, Resend: si.siResend, Jenkins: si.siJenkins, GitLab: si.siGitlab, "Claude API": si.siClaude,
  "WhatsApp API": si.siWhatsapp, Neon: si.siNeon, Leaflet: si.siLeaflet, Vite: si.siVite,
  Drizzle: si.siDrizzle, Mapbox: si.siMapbox, GSAP: si.siGsap, OpenStreetMap: si.siOpenstreetmap,
};
const icon = map[name];
---
{icon ? (
  <svg class="tech-icon" width={size} height={size} viewBox="0 0 24 24" aria-hidden="true"><path d={icon.path} fill={`#${icon.hex === "000000" || icon.hex === "181717" || icon.hex === "0F0F11" ? "1b1b18" : icon.hex}`} /></svg>
) : name === "Oracle" ? (
  <svg class="tech-icon" width={size} height={size} viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="6" width="20" height="12" rx="6" fill="none" stroke="#C74634" stroke-width="3" /></svg>
) : name === "SQL" ? (
  <svg class="tech-icon" width={size} height={size} viewBox="0 0 24 24" aria-hidden="true"><ellipse cx="12" cy="5" rx="8" ry="3" fill="#6d7fd6" /><path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5c0 1.7-3.6 3-8 3S4 6.7 4 5z" fill="#8a9be6" /><path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3" fill="none" stroke="#5163b8" stroke-width="1.2" /></svg>
) : (
  <svg class="tech-icon" width={size} height={size} viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" fill="#0d4038" /><text x="12" y="16" font-size="10" text-anchor="middle" fill="#f6efdc" font-family="monospace">{name.slice(0, 2)}</text></svg>
)}
