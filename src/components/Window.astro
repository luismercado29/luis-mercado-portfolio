---
// Ventana estilo Windows 9x reutilizable.
interface Props { title?: string; icon?: string; class?: string; tone?: "forest" | "paper" | "dark"; controls?: boolean; id?: string }
import Pixel from "./Pixel.astro";
const { title, icon, class: cls = "", tone = "forest", controls = true, id } = Astro.props;
---
<div class:list={["win", `win--${tone}`, cls]} id={id}>
  {title !== undefined && (
    <div class="win__bar">
      <span class="win__title">{icon && <Pixel name={icon} size={18} />}<slot name="title">{title}</slot></span>
      {controls && (
        <span class="win__controls" aria-hidden="true">
          <span class="wc wc--min"></span><span class="wc wc--max"></span><span class="wc wc--close"></span>
        </span>
      )}
    </div>
  )}
  <div class="win__body"><slot /></div>
</div>
